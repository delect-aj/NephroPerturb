# Copy to .env on the deployment host (never commit .env)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Visitor rate limits when DeepSeek ReAct is enabled on public server
AGENT_LLM_HOURLY_LIMIT_PER_IP=20
AGENT_LLM_DAILY_GLOBAL_LIMIT=500
AGENT_TRUST_PROXY_HEADERS=1

# Optional literature/runtime tuning
EUROPEPMC_TIMEOUT=4.5
NCBI_API_KEY=
NEPHRO_STATE_DIR=
